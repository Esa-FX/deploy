{
  "Comment": "Sev1 rollback: edit REPO SHA COMPOSE SERVICE PORT, then send-command. Checkout that SHA only; recreate one container. Hosts: CRM EC2 i-06c9b4647a1fc8ee8 (crm-api/client), core i-0230b88ebf9b7adea (identity/pii/audit-log), VoIP i-081933f9f6a99b067. Staging app i-06e3745274ed0fac4 + secret esafx/staging/github-clone.",
  "DocumentName": "AWS-RunShellScript",
  "InstanceIds": ["i-06c9b4647a1fc8ee8"],
  "TimeoutSeconds": 1800,
  "Parameters": {
    "commands": [
      "set -euxo pipefail",
      "cd /opt/esafx",
      "REGION=ap-southeast-3",
      "SECRET_ID=esafx/production/github-clone",
      "REPO=crm-service",
      "SHA=REPLACE_WITH_LAST_GOOD_SHA",
      "COMPOSE=deploy/production/docker-compose.crm.yml",
      "SERVICE=crm-api",
      "PORT=8001",
      "GITHUB_TOKEN=$(aws secretsmanager get-secret-value --secret-id $SECRET_ID --region $REGION --query SecretString --output text)",
      "url=\"https://x-access-token:${GITHUB_TOKEN}@github.com/Esa-FX/${REPO}.git\"",
      "git -C \"$REPO\" remote set-url origin \"$url\"",
      "git -C \"$REPO\" fetch origin",
      "git -C \"$REPO\" checkout --detach \"$SHA\"",
      "git -C \"$REPO\" remote set-url origin \"https://github.com/Esa-FX/${REPO}.git\"",
      "git -C \"$REPO\" log -1 --oneline",
      "docker compose -f \"$COMPOSE\" build \"$SERVICE\"",
      "docker compose -f \"$COMPOSE\" up -d --force-recreate \"$SERVICE\"",
      "sleep 20",
      "curl -sf \"http://127.0.0.1:${PORT}/health\" && echo rollback-ok",
      "unset GITHUB_TOKEN"
    ]
  }
}
