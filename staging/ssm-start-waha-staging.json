      "docker exec esafx-whatsapp-gateway curl -sf http://127.0.0.1:8007/health/whatsapp | head -c 400",
      "docker ps --filter name=esafx-waha --filter name=esafx-whatsapp-gateway --format 'table {{.Names}}\\t{{.Status}}'"
