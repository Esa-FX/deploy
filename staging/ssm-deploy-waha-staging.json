{
  "DocumentName": "AWS-RunShellScript",
  "InstanceIds": ["i-06e3745274ed0fac4"],
  "TimeoutSeconds": 3600,
  "Parameters": {
    "commands": [
      "set -euo pipefail",
      "cd /opt/esafx",
      "REGION=ap-southeast-3",
      "GITHUB_TOKEN=$(aws secretsmanager get-secret-value --secret-id esafx/staging/github-clone --region \"$REGION\" --query SecretString --output text)",
      "git_pull() {",
      "  local repo=\"$1\" branch=\"$2\"",
      "  git -C \"$repo\" remote set-url origin \"https://x-access-token:${GITHUB_TOKEN}@github.com/Esa-FX/${repo}.git\"",
      "  git -C \"$repo\" fetch origin \"$branch\"",
      "  git -C \"$repo\" checkout \"$branch\"",
      "  git -C \"$repo\" reset --hard \"origin/${branch}\"",
      "  git -C \"$repo\" log -1 --oneline",
      "  git -C \"$repo\" remote set-url origin \"https://github.com/Esa-FX/${repo}.git\"",
      "}",
      "git_pull whatsapp-gateway-service staging",
      "git_pull crm-service staging",
      "git_pull deploy main",
      "chmod +x deploy/staging/sync-service-tokens-env.sh deploy/staging/prepare-whatsapp-gateway.sh deploy/staging/deploy-app-ec2.sh || true",
      "./deploy/staging/sync-service-tokens-env.sh",
      "WA_ENV=whatsapp-gateway-service/.env.staging",
      "sed -i 's|^WHATSAPP_PROVIDER=.*|WHATSAPP_PROVIDER=waha|' \"$WA_ENV\"",
      "grep -q '^WAHA_BASE_URL=' \"$WA_ENV\" || echo 'WAHA_BASE_URL=http://waha:3000' >> \"$WA_ENV\"",
      "grep -q '^WAHA_DEFAULT_ENGINE=' \"$WA_ENV\" || echo 'WAHA_DEFAULT_ENGINE=NOWEB' >> \"$WA_ENV\"",
      "grep -q '^WAHA_MARK_READ_ON_CRM_OPEN=' \"$WA_ENV\" || echo 'WAHA_MARK_READ_ON_CRM_OPEN=true' >> \"$WA_ENV\"",
      "if ! grep -q '^WAHA_WEBHOOK_URL=.' \"$WA_ENV\"; then echo 'WAHA_WEBHOOK_URL=http://whatsapp-gateway:8007/webhooks/waha' >> \"$WA_ENV\"; fi",
      "if ! grep -q '^WAHA_API_KEY=.' \"$WA_ENV\"; then echo \"WAHA_API_KEY=$(openssl rand -hex 24)\" >> \"$WA_ENV\"; fi",
      "sed -i '/^WWEBJS_AUTH_DIR=/d' \"$WA_ENV\" 2>/dev/null || true",
      "mkdir -p /opt/esafx/data/waha-sessions /opt/esafx/data/chat-media",
      "chmod 777 /opt/esafx/data/waha-sessions /opt/esafx/data/chat-media 2>/dev/null || true",
      "./deploy/staging/prepare-whatsapp-gateway.sh",
      "export COMPOSE_PARALLEL_LIMIT=1",
      "chmod +x deploy/staging/prune-docker-disk.sh || true",
      "./deploy/staging/prune-docker-disk.sh",
      "docker compose -f deploy/staging/docker-compose.app.yml pull waha",
      "docker compose -f deploy/staging/docker-compose.app.yml build crm-api whatsapp-gateway",
      "docker compose -f deploy/staging/docker-compose.app.yml run --rm crm-migrate",
      "docker compose -f deploy/staging/docker-compose.app.yml up -d --force-recreate --no-deps waha",
      "for i in $(seq 1 24); do docker exec esafx-waha curl -sf http://127.0.0.1:3000/health && break || sleep 5; done",
      "docker exec esafx-waha curl -sf http://127.0.0.1:3000/health && echo WAHA_OK",
      "./deploy/staging/prepare-whatsapp-gateway.sh",
      "docker compose -f deploy/staging/docker-compose.app.yml up -d --force-recreate --no-deps whatsapp-gateway crm-api",
      "for i in $(seq 1 24); do docker exec esafx-whatsapp-gateway curl -sf http://127.0.0.1:8007/health && break || sleep 5; done",
      "docker exec esafx-whatsapp-gateway curl -sf http://127.0.0.1:8007/health && echo GW_OK",
      "docker exec esafx-crm-api curl -sf http://whatsapp-gateway:8007/health && echo CRM_TO_GW_OK",
      "docker exec esafx-whatsapp-gateway curl -sS http://127.0.0.1:8007/health/whatsapp || true",
      "docker ps --filter name=esafx-waha --filter name=esafx-whatsapp-gateway --filter name=esafx-crm-api --format 'table {{.Names}}\\t{{.Status}}'",
      "echo 'WAHA cutover deployed. Re-pair all team leaders at /admin/whatsapp.'"
    ]
  }
}
